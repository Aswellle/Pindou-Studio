<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!--
    说明:
    - 本文件是给 Google/Bing/搜狗/360 等通用搜索引擎的标准 sitemap,只使用
      sitemaps.org 与 xhtml 命名空间。此前混入的百度移动扩展
      (xmlns:mobile 与 mobile 扩展标记)会让 Google 报「命名空间不正确」,
      已拆分到构建时生成的 /sitemap-baidu.xml(只提交给百度平台)。
    - 本站为自适应(响应式)站点,PC 与移动端同一套 URL;Baidu 变体里每页标注
      type=pc,mobile,无需再走「移动适配」工具提交对应关系。
    - hreflang 语言变体使用 ?lang=en|ja|ko(与页面内 hreflang、页面 canonical 保持互指);
      x-default 指向默认语言(简体中文)版本。
    - Google 会忽略 priority/changefreq,保留仅为兼容百度/搜狗/360 的读取。
    - 静态页 lastmod 由构建脚本按 git 提交历史自动推导(scripts/sitemap-lastmod.mjs);
      此处的值是查不到历史时(浅克隆/无 git 环境)的兜底,不需要手工维护。
  -->

  <!-- 首页(画布工具) — SEO 头信息与结构化数据于 2026-10-12 更新;2026-11-09 正文补充分享能力 -->
  <url>
    <loc>https://tangnotes.site/</loc>
    <lastmod>2026-11-09</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://tangnotes.site/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://tangnotes.site/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://tangnotes.site/?lang=ja"/>
    <xhtml:link rel="alternate" hreflang="ko" href="https://tangnotes.site/?lang=ko"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://tangnotes.site/"/>
  </url>

  <!-- 图库 — 模板内容库 -->
  <url>
    <loc>https://tangnotes.site/gallery</loc>
    <lastmod>2026-10-12</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://tangnotes.site/gallery"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://tangnotes.site/gallery?lang=en"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://tangnotes.site/gallery?lang=ja"/>
    <xhtml:link rel="alternate" hreflang="ko" href="https://tangnotes.site/gallery?lang=ko"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://tangnotes.site/gallery"/>
  </url>

  <!-- 教程 — 四语言教程内容 -->
  <url>
    <loc>https://tangnotes.site/tutorials</loc>
    <lastmod>2026-10-12</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://tangnotes.site/tutorials"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://tangnotes.site/tutorials?lang=en"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://tangnotes.site/tutorials?lang=ja"/>
    <xhtml:link rel="alternate" hreflang="ko" href="https://tangnotes.site/tutorials?lang=ko"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://tangnotes.site/tutorials"/>
  </url>

  <!-- 隐私政策 — 正文写死在 LegalPages.jsx 里,只有中文,不提供 ?lang= 变体。
       页面内 hreflang 也只声明 zh-CN 与 x-default;此处保持一致,否则 sitemap
       声明四种语言、页面只认一种,两边互相矛盾会被判为 hreflang 组无效。 -->
  <url>
    <loc>https://tangnotes.site/privacy</loc>
    <lastmod>2026-10-12</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

  <!-- 服务条款 — 同上,中文单语 -->
  <url>
    <loc>https://tangnotes.site/terms</loc>
    <lastmod>2026-10-12</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
