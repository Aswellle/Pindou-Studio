{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pindou-studio.vercel.app"
        }
      ],
      "destination": "https://tangnotes.site/:path*",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/tutorials.html",
      "destination": "/tutorials",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://gccrwnepwtpcsiqowzro.supabase.co/:path*"
    },
    {
      "source": "/share/:id",
      "destination": "/api/share-preview/:id"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/tutorials",
      "destination": "/tutorials.html"
    },
    {
      "source": "/create/image",
      "destination": "/create-image.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy/:versionId",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms/:versionId",
      "destination": "/terms.html"
    },

    {
      "source": "/gallery/theme/:slug",
      "destination": "/api/gallery-detail/theme/:slug"
    },
    {
      "source": "/gallery/collection/:slug",
      "destination": "/api/gallery-detail/collection/:slug"
    },
    {
      "source": "/gallery/pattern/:id",
      "destination": "/api/gallery-detail/pattern/:id"
    },

    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/profile",
      "destination": "/spa.html"
    },
    {
      "source": "/create/image",
      "destination": "/spa.html"
    },
    {
      "source": "/import",
      "destination": "/spa.html"
    },
    {
      "source": "/my/beads",
      "destination": "/spa.html"
    },
    {
      "source": "/contact",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/login",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/spa.html"
    }
  ],
  "functions": {
    "api/share-preview/[id].js": {
      "includeFiles": "dist/spa.html"
    },
    "api/gallery-detail/pattern/[id].js": {
      "includeFiles": "dist/{spa,404}.html"
    },
    "api/gallery-detail/theme/[slug].js": {
      "includeFiles": "dist/{spa,404}.html"
    },
    "api/gallery-detail/collection/[slug].js": {
      "includeFiles": "dist/{spa,404}.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
