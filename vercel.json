{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pindou-studio.vercel.app"
        }
      ],
      "destination": "https://tangnotes.site/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.tangnotes.site"
        }
      ],
      "destination": "https://tangnotes.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tangnotes.site"
        }
      ],
      "destination": "https://tangnotes.site/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/tutorials.html",
      "destination": "/tutorials",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/colors.html",
      "destination": "/colors",
      "permanent": true
    },
    {
      "source": "/ironing.html",
      "destination": "/ironing",
      "permanent": true
    },
    {
      "source": "/bead-calculator.html",
      "destination": "/bead-calculator",
      "permanent": true
    },
    {
      "source": "/bead-patterns.html",
      "destination": "/bead-patterns",
      "permanent": true
    },
    {
      "source": "/pixel-art.html",
      "destination": "/pixel-art",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://gccrwnepwtpcsiqowzro.supabase.co/:path*"
    },
    {
      "source": "/share/:id",
      "destination": "/api/share-preview/:id"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/tutorials",
      "destination": "/tutorials.html"
    },
    {
      "source": "/create/image",
      "destination": "/create-image.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/colors",
      "destination": "/colors.html"
    },
    {
      "source": "/colors/:brand(coco|mard|mard291|perler|hama|artkal)",
      "destination": "/spa.html"
    },
    {
      "source": "/ironing",
      "destination": "/ironing.html"
    },
    {
      "source": "/bead-calculator",
      "destination": "/bead-calculator.html"
    },
    {
      "source": "/bead-patterns",
      "destination": "/bead-patterns.html"
    },
    {
      "source": "/pixel-art",
      "destination": "/pixel-art.html"
    },
    {
      "source": "/privacy/:versionId",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms/:versionId",
      "destination": "/terms.html"
    },

    {
      "source": "/gallery/category/:slug(animal|food|icon|holiday|cartoon|person|celebration|emoji|plant|device|clothing)",
      "destination": "/spa.html"
    },
    {
      "source": "/gallery/theme/:slug",
      "destination": "/api/gallery-detail/theme/:slug"
    },
    {
      "source": "/gallery/collection/:slug",
      "destination": "/api/gallery-detail/collection/:slug"
    },
    {
      "source": "/gallery/pattern/:id",
      "destination": "/api/gallery-detail/pattern/:id"
    },

    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/profile",
      "destination": "/spa.html"
    },
    {
      "source": "/create/image",
      "destination": "/spa.html"
    },
    {
      "source": "/import",
      "destination": "/spa.html"
    },
    {
      "source": "/my/beads",
      "destination": "/spa.html"
    },
    {
      "source": "/contact",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/login",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/spa.html"
    }
  ],
  "functions": {
    "api/share-preview/[id].js": {
      "includeFiles": "dist/spa.html"
    },
    "api/gallery-detail/pattern/[id].js": {
      "includeFiles": "dist/{spa,404}.html"
    },
    "api/gallery-detail/theme/[slug].js": {
      "includeFiles": "dist/{spa,404}.html"
    },
    "api/gallery-detail/collection/[slug].js": {
      "includeFiles": "dist/{spa,404}.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/import",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/my/beads",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/spa.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pattern-img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
