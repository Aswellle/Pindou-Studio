{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pindou-studio.vercel.app"
        }
      ],
      "destination": "https://tangnotes.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(admin|gallery|tutorials|privacy|terms)", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
